{
  // README sizes the app icon with <img width="64">; Markdown cannot set an
  // image size, so allow that one element. Other inline HTML stays reported.
  "MD033": { "allowed_elements": ["img"] },

  // Prose stays at 80 columns; README tables and shell examples are wider by
  // design.
  "MD013": {
    "line_length": 80,
    "code_blocks": false,
    "tables": false,
    "headings": false
  }
}
