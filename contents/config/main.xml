<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0 https://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
  <kcfgfile name="" />
  <group name="General">
    <entry name="treatWeekendWorkdayAsPeak" type="Bool">
      <default>false</default>
    </entry>
    <entry name="displayMode" type="String">
      <default>combined</default>
    </entry>
    <entry name="backgroundStyle" type="String">
      <default>glass</default>
    </entry>
    <entry name="glassOpacity" type="Int">
      <default>55</default>
    </entry>
    <entry name="visualTheme" type="String">
      <default>system</default>
    </entry>
    <entry name="customHolidays" type="String">
      <default></default>
    </entry>
    <entry name="showBalance" type="Bool">
      <default>true</default>
    </entry>
    <entry name="walletName" type="String">
      <default>kdewallet</default>
    </entry>
    <entry name="walletFolder" type="String">
      <default>DeepSeek</default>
    </entry>
    <entry name="walletEntry" type="String">
      <default>api_key</default>
    </entry>
  </group>
</kcfg>